<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Proposto" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Proposto"><bpmn:participant id="Pool_Proposto" name="Processo proposto com o sistema (como será) — proposta a validar" processRef="Process_Proposto"/></bpmn:collaboration>
  <bpmn:process id="Process_Proposto" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Proposto">
      <bpmn:lane id="Lane_resp" name="RH ou Gestor">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T9</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sis" name="Sistema">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_aval" name="Avaliadores">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T10</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_colab" name="Colaborador avaliado">
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T8</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Ciclo de avaliação planejado"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="T1" name="Configurar coleta: modalidade, questionário e participantes (CU-01, CU-09)"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="T2" name="Publicar questionário e gerar avaliações (RF09, RF10, RF17)"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="T3" name="Responder e enviar avaliações, inclusive autoavaliação (CU-02)"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T4" name="Acompanhar e encerrar a coleta (CU-03)"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="T5" name="Liberar resultados e calcular indicadores (RF15, RN15)"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="T6" name="Consultar resultados e histórico (CU-04)"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="Ação de desenvolvimento acordada?"><bpmn:incoming>F7</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing><bpmn:outgoing>F9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="T7" name="Criar plano de ação com o colaborador (CU-11)"><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T8" name="Executar ações e registrar progresso (RF18)"><bpmn:incoming>F10</bpmn:incoming><bpmn:outgoing>F11</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="T9" name="Registrar verificações e novo feedback (RN13)"><bpmn:incoming>F11</bpmn:incoming><bpmn:outgoing>F12</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="E1" name="Resultados avaliados no próximo ciclo"><bpmn:incoming>F12</bpmn:incoming></bpmn:endEvent>
    <bpmn:endEvent id="E2" name="Ciclo encerrado"><bpmn:incoming>F9</bpmn:incoming></bpmn:endEvent>
    <bpmn:startEvent id="S2" name="Evento observado"><bpmn:outgoing>F13</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="T10" name="Registrar feedback informal com fato e impacto (CU-10)"><bpmn:incoming>F13</bpmn:incoming><bpmn:outgoing>F14</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="E3" name="Feedback disponível ao receptor"><bpmn:incoming>F14</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3"/>
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="T4"/>
    <bpmn:sequenceFlow id="F5" sourceRef="T4" targetRef="T5"/>
    <bpmn:sequenceFlow id="F6" sourceRef="T5" targetRef="T6"/>
    <bpmn:sequenceFlow id="F7" sourceRef="T6" targetRef="G1"/>
    <bpmn:sequenceFlow id="F8" name="sim" sourceRef="G1" targetRef="T7"/>
    <bpmn:sequenceFlow id="F9" name="não" sourceRef="G1" targetRef="E2"/>
    <bpmn:sequenceFlow id="F10" sourceRef="T7" targetRef="T8"/>
    <bpmn:sequenceFlow id="F11" sourceRef="T8" targetRef="T9"/>
    <bpmn:sequenceFlow id="F12" sourceRef="T9" targetRef="E1"/>
    <bpmn:sequenceFlow id="F13" sourceRef="S2" targetRef="T10"/>
    <bpmn:sequenceFlow id="F14" sourceRef="T10" targetRef="E3"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_Proposto"><bpmndi:BPMNPlane id="Plane_Proposto" bpmnElement="Collab_Proposto">
    <bpmndi:BPMNShape id="Pool_Proposto_di" bpmnElement="Pool_Proposto" isHorizontal="true"><dc:Bounds x="40" y="40" width="2370" height="680"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_resp_di" bpmnElement="Lane_resp" isHorizontal="true"><dc:Bounds x="70" y="40" width="2340" height="170"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_sis_di" bpmnElement="Lane_sis" isHorizontal="true"><dc:Bounds x="70" y="210" width="2340" height="170"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_aval_di" bpmnElement="Lane_aval" isHorizontal="true"><dc:Bounds x="70" y="380" width="2340" height="170"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_colab_di" bpmnElement="Lane_colab" isHorizontal="true"><dc:Bounds x="70" y="550" width="2340" height="170"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="167" y="107" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="300" y="85" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="490" y="255" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="680" y="425" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="870" y="85" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="1060" y="255" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="1250" y="595" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="1490" y="100" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T7_di" bpmnElement="T7"><dc:Bounds x="1630" y="85" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T8_di" bpmnElement="T8"><dc:Bounds x="1820" y="595" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T9_di" bpmnElement="T9"><dc:Bounds x="2010" y="85" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="2257" y="107" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E2_di" bpmnElement="E2"><dc:Bounds x="1687" y="617" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S2_di" bpmnElement="S2"><dc:Bounds x="167" y="447" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T10_di" bpmnElement="T10"><dc:Bounds x="300" y="425" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E3_di" bpmnElement="E3"><dc:Bounds x="547" y="447" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="203" y="125"/><di:waypoint x="300" y="125"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="450" y="125"/><di:waypoint x="470" y="125"/><di:waypoint x="470" y="295"/><di:waypoint x="490" y="295"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="640" y="295"/><di:waypoint x="660" y="295"/><di:waypoint x="660" y="465"/><di:waypoint x="680" y="465"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="830" y="465"/><di:waypoint x="850" y="465"/><di:waypoint x="850" y="125"/><di:waypoint x="870" y="125"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="1020" y="125"/><di:waypoint x="1040" y="125"/><di:waypoint x="1040" y="295"/><di:waypoint x="1060" y="295"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1210" y="295"/><di:waypoint x="1230" y="295"/><di:waypoint x="1230" y="635"/><di:waypoint x="1250" y="635"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1400" y="635"/><di:waypoint x="1445" y="635"/><di:waypoint x="1445" y="125"/><di:waypoint x="1490" y="125"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1540" y="125"/><di:waypoint x="1630" y="125"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1515" y="150"/><di:waypoint x="1515" y="635"/><di:waypoint x="1687" y="635"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1780" y="125"/><di:waypoint x="1800" y="125"/><di:waypoint x="1800" y="635"/><di:waypoint x="1820" y="635"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1970" y="635"/><di:waypoint x="1990" y="635"/><di:waypoint x="1990" y="125"/><di:waypoint x="2010" y="125"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="2160" y="125"/><di:waypoint x="2257" y="125"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="203" y="465"/><di:waypoint x="300" y="465"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="450" y="465"/><di:waypoint x="547" y="465"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
