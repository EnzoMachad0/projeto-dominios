<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_Atual" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:collaboration id="Collab_Atual"><bpmn:participant id="Pool_Atual" name="Processo atual de avaliação e feedback (como é) — proposta a validar" processRef="Process_Atual"/></bpmn:collaboration>
  <bpmn:process id="Process_Atual" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Atual">
      <bpmn:lane id="Lane_rh" name="RH">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_gestor" name="Gestor">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_colab" name="Colaborador">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S1" name="Período de avaliação definido"><bpmn:outgoing>F1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:manualTask id="T1" name="Distribuir planilha ou formulário genérico"><bpmn:incoming>F1</bpmn:incoming><bpmn:outgoing>F2</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="T2" name="Avaliar o colaborador com critérios próprios"><bpmn:incoming>F2</bpmn:incoming><bpmn:outgoing>F3</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="T3" name="Conversar com o colaborador sobre o resultado"><bpmn:incoming>F3</bpmn:incoming><bpmn:outgoing>F4</bpmn:outgoing></bpmn:manualTask>
    <bpmn:manualTask id="T4" name="Receber o feedback"><bpmn:incoming>F4</bpmn:incoming><bpmn:outgoing>F5</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="G1" name="Ação de melhoria combinada?"><bpmn:incoming>F5</bpmn:incoming><bpmn:outgoing>F6</bpmn:outgoing><bpmn:outgoing>F7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="T5" name="Combinar ações verbalmente, sem registro"><bpmn:incoming>F6</bpmn:incoming><bpmn:outgoing>F8</bpmn:outgoing></bpmn:manualTask>
    <bpmn:exclusiveGateway id="G2" name=""><bpmn:incoming>F7</bpmn:incoming><bpmn:incoming>F8</bpmn:incoming><bpmn:outgoing>F9</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:manualTask id="T6" name="Guardar planilhas em pastas e e-mails"><bpmn:incoming>F9</bpmn:incoming><bpmn:outgoing>F10</bpmn:outgoing></bpmn:manualTask>
    <bpmn:endEvent id="E1" name="Ciclo encerrado sem acompanhamento"><bpmn:incoming>F10</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="F1" sourceRef="S1" targetRef="T1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3"/>
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="T4"/>
    <bpmn:sequenceFlow id="F5" sourceRef="T4" targetRef="G1"/>
    <bpmn:sequenceFlow id="F6" name="sim" sourceRef="G1" targetRef="T5"/>
    <bpmn:sequenceFlow id="F7" name="não" sourceRef="G1" targetRef="G2"/>
    <bpmn:sequenceFlow id="F8" sourceRef="T5" targetRef="G2"/>
    <bpmn:sequenceFlow id="F9" sourceRef="G2" targetRef="T6"/>
    <bpmn:sequenceFlow id="F10" sourceRef="T6" targetRef="E1"/>
    <bpmn:textAnnotation id="Ann_0"><bpmn:text>Dor D1</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_0" sourceRef="T1" targetRef="Ann_0"/>
    <bpmn:textAnnotation id="Ann_1"><bpmn:text>Dor D1, D6</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_1" sourceRef="T2" targetRef="Ann_1"/>
    <bpmn:textAnnotation id="Ann_2"><bpmn:text>Dor D2</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_2" sourceRef="T3" targetRef="Ann_2"/>
    <bpmn:textAnnotation id="Ann_3"><bpmn:text>Dor D4</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_3" sourceRef="T5" targetRef="Ann_3"/>
    <bpmn:textAnnotation id="Ann_4"><bpmn:text>Dor D3, D5</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_4" sourceRef="T6" targetRef="Ann_4"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diag_Atual"><bpmndi:BPMNPlane id="Plane_Atual" bpmnElement="Collab_Atual">
    <bpmndi:BPMNShape id="Pool_Atual_di" bpmnElement="Pool_Atual" isHorizontal="true"><dc:Bounds x="40" y="40" width="1990" height="510"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_rh_di" bpmnElement="Lane_rh" isHorizontal="true"><dc:Bounds x="70" y="40" width="1960" height="170"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_gestor_di" bpmnElement="Lane_gestor" isHorizontal="true"><dc:Bounds x="70" y="210" width="1960" height="170"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Lane_colab_di" bpmnElement="Lane_colab" isHorizontal="true"><dc:Bounds x="70" y="380" width="1960" height="170"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="S1_di" bpmnElement="S1"><dc:Bounds x="167" y="107" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T1_di" bpmnElement="T1"><dc:Bounds x="300" y="85" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T2_di" bpmnElement="T2"><dc:Bounds x="490" y="255" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T3_di" bpmnElement="T3"><dc:Bounds x="680" y="255" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T4_di" bpmnElement="T4"><dc:Bounds x="870" y="425" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="G1_di" bpmnElement="G1" isMarkerVisible="true"><dc:Bounds x="1110" y="440" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T5_di" bpmnElement="T5"><dc:Bounds x="1250" y="425" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="G2_di" bpmnElement="G2" isMarkerVisible="true"><dc:Bounds x="1490" y="440" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="T6_di" bpmnElement="T6"><dc:Bounds x="1630" y="85" width="150" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="E1_di" bpmnElement="E1"><dc:Bounds x="1877" y="107" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="203" y="125"/><di:waypoint x="300" y="125"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="450" y="125"/><di:waypoint x="470" y="125"/><di:waypoint x="470" y="295"/><di:waypoint x="490" y="295"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="640" y="295"/><di:waypoint x="680" y="295"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="830" y="295"/><di:waypoint x="850" y="295"/><di:waypoint x="850" y="465"/><di:waypoint x="870" y="465"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="1020" y="465"/><di:waypoint x="1110" y="465"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1160" y="465"/><di:waypoint x="1250" y="465"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1135" y="490"/><di:waypoint x="1135" y="520"/><di:waypoint x="1515" y="520"/><di:waypoint x="1515" y="490"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1400" y="465"/><di:waypoint x="1490" y="465"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1540" y="465"/><di:waypoint x="1585" y="465"/><di:waypoint x="1585" y="125"/><di:waypoint x="1630" y="125"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1780" y="125"/><di:waypoint x="1877" y="125"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNShape id="Ann_0_di" bpmnElement="Ann_0"><dc:Bounds x="430" y="51" width="70" height="24"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Assoc_0_di" bpmnElement="Assoc_0"><di:waypoint x="440" y="85"/><di:waypoint x="440" y="75"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNShape id="Ann_1_di" bpmnElement="Ann_1"><dc:Bounds x="620" y="221" width="70" height="24"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Assoc_1_di" bpmnElement="Assoc_1"><di:waypoint x="630" y="255"/><di:waypoint x="630" y="245"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNShape id="Ann_2_di" bpmnElement="Ann_2"><dc:Bounds x="810" y="221" width="70" height="24"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Assoc_2_di" bpmnElement="Assoc_2"><di:waypoint x="820" y="255"/><di:waypoint x="820" y="245"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNShape id="Ann_3_di" bpmnElement="Ann_3"><dc:Bounds x="1380" y="391" width="70" height="24"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Assoc_3_di" bpmnElement="Assoc_3"><di:waypoint x="1390" y="425"/><di:waypoint x="1390" y="415"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNShape id="Ann_4_di" bpmnElement="Ann_4"><dc:Bounds x="1760" y="51" width="70" height="24"/></bpmndi:BPMNShape>
