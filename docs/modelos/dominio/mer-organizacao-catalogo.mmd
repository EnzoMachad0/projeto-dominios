erDiagram
    TIME o|--o{ USUARIO : lota
    USUARIO o|--o{ TIME : gerencia
    USUARIO ||--o{ RELACAO_TRABALHO : usuario_a
    USUARIO ||--o{ RELACAO_TRABALHO : usuario_b
    GRUPO_PARAM ||--o{ PARAM : agrupa
    USUARIO |o--o{ EVENTO_AUDITORIA : executa

    TIME {
        uuid id PK
        string nome
        string setor
        uuid id_gestor FK
        boolean ativo
    }
    USUARIO {
        uuid id PK
        uuid id_time FK
        string nome
        string cargo
        string email UK "único (UQ)"
        enum role
        boolean ativo
    }
    RELACAO_TRABALHO {
        uuid id_usuario_a PK,FK
        uuid id_usuario_b PK,FK
        boolean ativo
    }
    GRUPO_PARAM {
        uuid id PK
        string titulo
        string descricao
        boolean ativo
    }
    PARAM {
        uuid id PK
        uuid id_grupo_param FK
        string pergunta
        enum score
        boolean ativo
    }
    EVENTO_AUDITORIA {
        uuid id PK
        uuid id_ator FK "opcional em operação automática"
        string operacao
        string entidade
        uuid id_alvo "opcional se a PK do alvo é composta"
        json chave_alvo
        datetime ocorrido_em
        json metadados
    }
